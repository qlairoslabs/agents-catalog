{"tools":[{"name":"find_services","description":"Use when the user needs help identifying which TaskMan of London service fits their job, especially for vague home-service requests in London.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"query":{"type":"string","minLength":2,"maxLength":200},"area":{"type":"string","minLength":2,"maxLength":80},"urgency":{"type":"string","enum":["flexible","specific_date","urgent"]}},"additionalProperties":false},"effect":{"effect":"read","hash":"bbf1d434d840059c0b5699ab1868fa42836f07e52ac0b69a4d0b592c862462a7"}},{"name":"check_service_area","description":"Use when the user provides a London postcode or asks whether TaskMan covers their area.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"postcode":{"type":"string","minLength":3,"maxLength":12},"service_type":{"type":"string","enum":["furniture_assembly","wall_mounting","handyman","electrician","smart_home_installation"]}},"required":["postcode"],"additionalProperties":false},"effect":{"effect":"read","hash":"7283affe65b25ef9856c31bf79abfd727256aaf1d10935acc2d084a20a798192"}},{"name":"get_quote_estimate","description":"Use when the user asks about likely cost, ballpark pricing, or whether a task needs a custom quote.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"service_type":{"type":"string","enum":["furniture_assembly","wall_mounting","handyman","electrician","smart_home_installation"]},"task_summary":{"type":"string","minLength":8,"maxLength":500},"item_count":{"type":"integer","exclusiveMinimum":0,"maximum":25},"item_type":{"type":"string","maxLength":80},"brand":{"type":"string","maxLength":80},"wall_type":{"type":"string","maxLength":80},"photos_provided":{"type":"boolean"},"postcode":{"type":"string","maxLength":12},"preferred_date":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"}},"required":["service_type","task_summary"],"additionalProperties":false},"effect":{"effect":"read","hash":"b156e06075627408b2ccb0ac9788a67c57e48db0c7920ba2cc80e90b7d3918a5"}},{"name":"check_availability","description":"Use when the user asks about dates, timing, or whether a service can likely be booked soon.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"service_type":{"type":"string","enum":["furniture_assembly","wall_mounting","handyman","electrician","smart_home_installation"]},"postcode":{"type":"string","minLength":3,"maxLength":12},"preferred_date":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},"time_preference":{"type":"string","enum":["morning","afternoon","evening","flexible"]}},"required":["service_type","postcode"],"additionalProperties":false},"effect":{"effect":"read","hash":"c06d65def3ca1bb5ed2858f7bfba11e713d12f241b6ec63b37d6b83ee7eb9273"}},{"name":"match_providers","description":"Use when an agent needs a single deterministic provider-matching result for assignment. Returns an ordered_candidates array sorted best-to-worst, where the first can_assign=true candidate is the assignee.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"service_type":{"type":"string","enum":["furniture_assembly","wall_mounting","handyman","electrician","smart_home_installation"]},"area_postcode":{"type":"string","minLength":2,"maxLength":12},"urgency":{"type":"string","enum":["flexible","specific_date","urgent"]},"preferred_date":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},"location_id":{"type":"string","minLength":1,"maxLength":120}},"required":["service_type","area_postcode","urgency"],"additionalProperties":false},"effect":{"effect":"read","hash":"629bc3865fcbd1e96729abefd212cd2986bef013ce3e7f48de2b948d7366cb82"}},{"name":"create_booking_request","description":"Use when the user is ready to submit details for a real TaskMan of London booking request.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"customer_name":{"type":"string","minLength":2,"maxLength":120},"phone":{"type":"string","minLength":7,"maxLength":25},"email":{"type":"string","format":"email","pattern":"^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"},"postcode":{"type":"string","minLength":3,"maxLength":12},"service_type":{"type":"string","enum":["furniture_assembly","wall_mounting","handyman","electrician","smart_home_installation"]},"task_summary":{"type":"string","minLength":8,"maxLength":500},"idempotency_key":{"type":"string","minLength":8,"maxLength":200},"preferred_date":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},"time_preference":{"type":"string","enum":["morning","afternoon","evening","flexible"]},"photos_url":{"type":"string","format":"uri"},"source":{"default":"chatgpt_app","type":"string","const":"chatgpt_app"},"consent_to_contact":{"type":"boolean"}},"required":["customer_name","phone","postcode","service_type","task_summary","consent_to_contact"],"additionalProperties":false},"effect":{"effect":"write","hash":"723243519d3986f0fbe9f17baf90c962ea8da655868ea7e2901980dda7cd70fb"}},{"name":"get_booking_status","description":"Use when the user already has a TaskMan booking request and wants an update.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"booking_request_id":{"type":"string","minLength":4,"maxLength":80},"phone":{"type":"string","minLength":7,"maxLength":25},"email":{"type":"string","format":"email","pattern":"^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"}},"required":["booking_request_id"],"additionalProperties":false},"effect":{"effect":"read","hash":"c56e5fb2325fce54ce98af623c29f6f7297cc806ed8b218952597304170f0bdb"}},{"name":"start_trusted_phone_session","description":"Use in trusted telephony flows when the caller number is already verified by the channel provider and you need a short-lived booking session without OTP.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"identifier":{"type":"string","minLength":5,"maxLength":200}},"required":["identifier"],"additionalProperties":false},"effect":{"effect":"write","hash":"6f99d7c344177bf8c6095f1077a8097748fcabb56a005cc879a8436d1dc582e5"}},{"name":"start_customer_verification","description":"Use when an existing customer wants to verify identity (OTP or magic link) before assistant-led booking.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"identifier":{"type":"string","minLength":5,"maxLength":200},"method_preference":{"default":"auto","type":"string","enum":["otp","magic_link","auto"]},"channel_preference":{"default":"auto","type":"string","enum":["sms","email","auto"]}},"required":["identifier"],"additionalProperties":false},"effect":{"effect":"write","hash":"cf2a1b7d04b7fa369b2fb46e94a9124d8e3584ce8cb52ab7bfaa32fb656510b7"}},{"name":"verify_customer_otp","description":"Use after sending an OTP challenge, to verify the one-time passcode and open a short-lived booking session.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"challenge_id":{"type":"string","minLength":8,"maxLength":120},"otp_code":{"type":"string","pattern":"^\\d{4,8}$"}},"required":["challenge_id","otp_code"],"additionalProperties":false},"effect":{"effect":"write","hash":"8b864227338896430ef939e53ad3b14db9b2ec675ec95b968a53436b96594ef9"}},{"name":"verify_magic_link_token","description":"Use when the customer clicks a magic link and provides the token for verification.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"token":{"type":"string","minLength":24,"maxLength":4000}},"required":["token"],"additionalProperties":false},"effect":{"effect":"write","hash":"76e3201fb234578934249783ce059354cb6e31d4732111d6385ab6aa541043fe"}},{"name":"get_customer_profile","description":"Use after verification to load scoped customer profile details from CRM for booking.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"session_token":{"type":"string","minLength":20,"maxLength":300}},"required":["session_token"],"additionalProperties":false},"effect":{"effect":"read","hash":"472afb0773bf8188c88e21bb41d5df598db06b2cf69bdc7ad157b8711cafa166"}},{"name":"list_customer_addresses","description":"Use after verification to list saved addresses linked to the verified customer.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"session_token":{"type":"string","minLength":20,"maxLength":300}},"required":["session_token"],"additionalProperties":false},"effect":{"effect":"read","hash":"c3cfb82bd2ec321cd030b25d67f02f699a9ee96b8c97e91fe0de8022bb67f7b2"}},{"name":"list_service_types","description":"Use after verification to show supported service types before collecting booking details.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"session_token":{"type":"string","minLength":20,"maxLength":300}},"required":["session_token"],"additionalProperties":false},"effect":{"effect":"read","hash":"18bfec64a65da169f8d490e690f5b1d429a5d5f62af4f223a7a2923885f5bb44"}},{"name":"get_customer_availability","description":"Use after verification to check availability for a verified customer at a selected saved address.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"session_token":{"type":"string","minLength":20,"maxLength":300},"service_type":{"type":"string","enum":["furniture_assembly","wall_mounting","handyman","electrician","smart_home_installation"]},"address_id":{"type":"string","minLength":2,"maxLength":120},"preferred_date":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},"time_preference":{"type":"string","enum":["morning","afternoon","evening","flexible"]}},"required":["session_token","service_type"],"additionalProperties":false},"effect":{"effect":"read","hash":"8b9f8166b40186b3389bf4268173e1f866e9172fce79a873cca4077abff11a6e"}},{"name":"start_booking_payment","description":"Use after collecting booking details to create a Stripe checkout payment session before final booking submission.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"session_token":{"type":"string","minLength":20,"maxLength":300},"contact_id":{"type":"string","minLength":1,"maxLength":120},"service_type":{"type":"string","enum":["furniture_assembly","wall_mounting","handyman","electrician","smart_home_installation"]},"task_summary":{"type":"string","minLength":8,"maxLength":500},"preferred_date":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},"address_id":{"type":"string","minLength":2,"maxLength":120},"deposit_amount_minor":{"type":"integer","exclusiveMinimum":0,"maximum":500000}},"required":["session_token","service_type","task_summary"],"additionalProperties":false},"effect":{"effect":"risky","hash":"69c8b034dec02f75798e7e928c08260825c04a7000f301ae6ce902484b6b2f2e"}},{"name":"get_booking_payment_status","description":"Use to check whether a booking payment session is pending, paid, failed, canceled, or expired before attempting booking creation.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"session_token":{"type":"string","minLength":20,"maxLength":300},"payment_session_id":{"type":"string","minLength":6,"maxLength":200}},"required":["session_token","payment_session_id"],"additionalProperties":false},"effect":{"effect":"read","hash":"c6673608174c5bed55daa7354a1f5634357db4765ad1f7e95d7db84df2e60789"}},{"name":"create_customer_booking","description":"Use after verification, detail collection, and confirmed paid payment session to create a booking scoped to the verified customer.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"session_token":{"type":"string","minLength":20,"maxLength":300},"contact_id":{"type":"string","minLength":1,"maxLength":120},"service_type":{"type":"string","enum":["furniture_assembly","wall_mounting","handyman","electrician","smart_home_installation"]},"task_summary":{"type":"string","minLength":8,"maxLength":500},"payment_session_id":{"type":"string","minLength":6,"maxLength":200},"idempotency_key":{"type":"string","minLength":8,"maxLength":200},"address_id":{"type":"string","minLength":2,"maxLength":120},"preferred_date":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},"time_preference":{"type":"string","enum":["morning","afternoon","evening","flexible"]},"photos_url":{"type":"string","format":"uri"},"consent_to_contact":{"default":true,"type":"boolean"}},"required":["session_token","service_type","task_summary","payment_session_id"],"additionalProperties":false},"effect":{"effect":"write","hash":"a0b70f574ecc493f105c28fc2a291d4c8d6dad1a75e89a76569733c6f3c403ec"}},{"name":"update_contact_note","description":"Use to append an internal CRM note for the verified customer during or after booking.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"session_token":{"type":"string","minLength":20,"maxLength":300},"note":{"type":"string","minLength":4,"maxLength":2000}},"required":["session_token","note"],"additionalProperties":false},"effect":{"effect":"write","hash":"bb1bc6275be837a675148301ad740a6c7a84277d92219f8e63f7290765fac448"}},{"name":"tag_contact","description":"Use to add CRM tags to the verified customer for booking workflow tracking.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"session_token":{"type":"string","minLength":20,"maxLength":300},"tags":{"minItems":1,"maxItems":20,"type":"array","items":{"type":"string","minLength":1,"maxLength":80}}},"required":["session_token","tags"],"additionalProperties":false},"effect":{"effect":"write","hash":"8ba4d279e4b1379852051420b08dff35b03f926f758afa5fea73db808cbe0042"}}]}
