{"tools":[{"name":"search_optical_knowledge","description":"Search public optical education in Portuguese or English. Returns source excerpts, not medical advice or customer records.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"query":{"type":"string","minLength":2,"maxLength":160},"language":{"default":"pt","type":"string","enum":["pt","en"]},"limit":{"default":5,"type":"integer","minimum":1,"maximum":10}},"required":["query"],"additionalProperties":false},"effect":{"effect":"read","hash":"6d4ee5f66a91f592b1cff4548540400afe525450ee1b5f2de1db3ad3d227241c"}},{"name":"get_optical_topic","description":"Read a public optical topic by stable ID with references, related topics and limitations.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"id":{"type":"string","enum":["pupillary-distance","centration","decentration","frame-geometry","refractive-index","lens-materials","thickness-factors","vertex-distance","pantoscopic-tilt","prescription-transposition","prentice-rule","remote-edging","optical-store-management","optical-visagism"]},"language":{"default":"pt","type":"string","enum":["pt","en"]}},"required":["id"],"additionalProperties":false},"effect":{"effect":"read","hash":"67d8b8652ee4c9c8d598c55d8fdfd0ea996621c4f433ced653d46b28c351a509"}},{"name":"transpose_prescription","description":"Transpose sphere/cylinder notation without changing the prescription. Dioptres and degrees; axis 0–180. Does not diagnose or generate prescriptions.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"sphere":{"type":"number","minimum":-60,"maximum":60},"cylinder":{"type":"number","minimum":-30,"maximum":30},"axis":{"type":"number","minimum":0,"maximum":180},"language":{"default":"pt","type":"string","enum":["pt","en"]}},"required":["sphere","cylinder","axis"],"additionalProperties":false},"effect":{"effect":"read","hash":"cc0cbacda09458a