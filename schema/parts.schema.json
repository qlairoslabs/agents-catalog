{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/qlairoslabs/agents-catalog/main/schema/parts.schema.json",
  "title": "Catalogue parts (schema 1)",
  "description": "connectors.json holds connectors; skills.json holds skills and bundles, as hubs read both under outbound.skills.",
  "$defs": {
    "connectors": {
      "type": "object",
      "required": [
        "mcp"
      ],
      "properties": {
        "mcp": {
          "type": "array",
          "maxItems": 50000,
          "items": {
            "allOf": [
              {
                "$ref": "item.schema.json"
              },
              {
                "required": [
                  "connect"
                ]
              }
            ]
          }
        }
      }
    },
    "skills": {
      "type": "object",
      "required": [
        "skills",
        "bundles"
      ],
      "properties": {
        "skills": {
          "type": "array",
          "maxItems": 50000,
          "items": {
            "allOf": [
              {
                "$ref": "item.schema.json"
              },
              {
                "required": [
                  "skill"
                ]
              }
            ]
          }
        },
        "bundles": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "allOf": [
              {
                "$ref": "item.schema.json"
              },
              {
                "required": [
                  "bundle"
                ]
              }
            ]
          }
        }
      }
    },
    "tools": {
      "type": "object",
      "required": [
        "lists"
      ],
      "additionalProperties": false,
      "properties": {
        "lists": {
          "type": "object",
          "maxProperties": 10000,
          "propertyNames": {
            "minLength": 1,
            "maxLength": 256
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "sha256",
              "bytes",
              "tools"
            ],
            "additionalProperties": false,
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048576
              },
              "tools": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "read": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              "write": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              "risky": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              }
            }
          }
        }
      }
    },
    "toolList": {
      "type": "object",
      "required": [
        "tools"
      ],
      "additionalProperties": false,
      "properties": {
        "tools": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "$ref": "item.schema.json#/$defs/tool"
          }
        }
      }
    }
  }
}
