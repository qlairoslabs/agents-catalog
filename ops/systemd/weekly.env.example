# Copy to ~/.config/agents-catalog/weekly.env and adjust. No secrets here: the model
# login and the GitHub login come from the machine (see PROCESS.md).
CATALOG_CHECKOUT=/path/to/agents-catalog
CATALOG_CACHE=/path/to/catalog-cache
CATALOG_WORK=/path/to/catalog-runs
CATALOG_GITHUB_REPO=qlairoslabs/agents-catalog
CATALOG_PUBLISH=1
CATALOG_MAX_DROP_FRACTION=0.05
CLASSIFY_LABEL_MODEL=haiku
CLASSIFY_RECHECK_MODEL=sonnet
CLASSIFY_EFFECTS_MODEL=sonnet
# CATALOG_GIT_NAME=agents-catalog weekly
# CATALOG_GIT_EMAIL=weekly@users.noreply.github.com
# CLASSIFY_IMAGE=localhost/agents-standard:...
