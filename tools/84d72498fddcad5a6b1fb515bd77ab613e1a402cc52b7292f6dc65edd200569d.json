{"tools":[{"name":"get_episode","description":"Get one episode and its chapter metadata by slug.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"slug":{"type":"string","maxLength":160,"pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"}},"required":["slug"],"additionalProperties":false},"effect":{"effect":"read","hash":"9340a2f3944ef6998f8f09f4cd8c0801339fd6db99e0efc13fe9c050920759f5"}},{"name":"get_transcript_segment","description":"Get transcript turns overlapping an optional window of at most five minutes, with exact timestamps. Defaults to 00:00–03:00 so the first call stays within the response limit.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"episode":{"type":"string","maxLength":160,"pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"start_ms":{"type":"integer","minimum":0,"maximum":9007199254740991},"end_ms":{"type":"integer","exclusiveMinimum":0,"maximum":9007199254740991}},"required":["episode"],"additionalProperties":false},"effect":{"effect":"read","hash":"00e6880767da229354a01bf4ca91ccb7caec217abc707f184c0c378fb419fb6a"}},{"name":"list_episode_clips","description":"List released clips and external YouTube catalog entries for an episode. Each item carries its source-specific evidence; external entries do not imply local media or release evidence.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"slug":{"type":"string","maxLength":160,"pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"cursor":{"type":"string","minLength":1,"maxLength":1024},"limit":{"default":1,"type":"integer","minimum":1,"maximum":1}},"required":["slug"],"additionalProperties":false},"effect":{"effect":"read","hash":"3182eb53b15c7a9009682249f38b239fdbe0f9ad9ad917d792bc91594e7cd1cb"}},{"name":"get_clip","description":"Get a released clip ID or exact case-sensitive youtube-VIDEOID catalog ID with its source-specific transcript, media, publication, and evidence fields.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"id":{"anyOf":[{"type":"string","maxLength":160,"pattern":"^[a-z0-9]+(?:[-.][a-z0-9]+)*$"},{"type":"string","pattern":"^youtube-[A-Za-z0-9_-]{11}$"}]}},"required":["id"],"additionalProperties":false},"effect":{"effect":"read","hash":"89206f947838f1d4bae9203446290def1128bad5ddfa275fc1395249d4631958"}},{"name":"get_reading_trail","description":"Get an episode reading trail with citations and cursor pagination.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"slug":{"type":"string","maxLength":160,"pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"cursor":{"type":"string","minLength":1,"maxLength":1024},"limit":{"default":15,"type":"integer","minimum":1,"maximum":25}},"required":["slug"],"additionalProperties":false},"effect":{"effect":"read","hash":"13e441330e0f57d48a593ed77fea60543ad005dc7ac82521fa90825ef7a5c132"}},{"name":"get_flashcards","description":"Get reviewed, evidence-linked episode flashcards with bounded cursor pagination. No scoring or engagement coercion.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"slug":{"type":"string","maxLength":160,"pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"cursor":{"type":"string","minLength":1,"maxLength":1024},"limit":{"default":10,"type":"integer","minimum":1,"maximum":10}},"required":["slug"],"additionalProperties":false},"effect":{"effect":"read","hash":"d7cd8db1e768ffdbf933230ab372e80b2e093965daa24ad5795bb017d3b6ecfd"}}]}
