{"tools":[{"name":"email_verify","description":"Check one email's syntax, mail routing, disposable/free-provider/role flags, and SMTP recipient acceptance. Sends no email. DNS alone does not verify a mailbox. unknown means inconclusive or mailbox not checked; likely_deliverable is evidence, not a delivery guarantee. No login or API key required. Rate limited.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"email":{"type":"string","minLength":1,"maxLength":320}},"required":["email"],"additionalProperties":false},"effect":{"effect":"read","hash":"7b0427569aecfb674850b104278ceabbf4a8a301d66146a85eba8557715a7813"}},{"name":"photography_pricing","description":"Calculate session price, costs, profit and per-photo price. Margin is a percentage of selling price; currency-neutral, no conversion. Free, no authentication required. Rate limited.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"hoursOnSite":{"type":"number","minimum":0,"maximum":10000},"hourlyRate":{"type":"number","minimum":0,"maximum":1000000000000},"editingHours":{"type":"number","minimum":0,"maximum":10000},"editingRate":{"type":"number","minimum":0,"maximum":1000000000000},"gearTravelCost":{"type":"number","minimum":0,"maximum":1000000000000},"numPhotos":{"type":"integer","exclusiveMinimum":0,"maximum":1000000},"margin":{"type":"number","minimum":0,"maximum":95}},"required":["hoursOnSite","hourlyRate","editingHours","editingRate","gearTravelCost","numPhotos","margin"],"additionalProperties":false},"effect":{"effect":"read","hash":"05a33f4b3a5c321a0e756cea0c94f5df2bb8069dcf1f9244b875900a7b60b5ab"}},{"name":"freelance_rate","description":"Calculate sustainable rates. margin is a percentage buffer added to annual income plus overhead, matching the website. All money must use the same currency. Free, no authentication required. Rate limited.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"annualIncome":{"type":"number","minimum":0,"maximum":1000000000000},"overhead":{"type":"number","minimum":0,"maximum":1000000000000},"billableWeeks":{"type":"number","exclusiveMinimum":0,"maximum":53},"billableHours":{"type":"number","exclusiveMinimum":0,"maximum":168},"hoursPerDay":{"type":"number","exclusiveMinimum":0,"maximum":24},"margin":{"type":"number","minimum":0,"maximum":95}},"required":["annualIncome","overhead","billableWeeks","billableHours","hoursPerDay","margin"],"additionalProperties":false},"effect":{"effect":"read","hash":"fede39cfd7702b706999050bdceac04f7245054cf151648502847a5cde6e682a"}},{"name":"agency_pricing","description":"Calculate project price from labor, overhead and risk buffer. margin is percentage of selling price; overhead and riskBuffer are percentage additions. Free, no authentication required. Rate limited.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"hourlyCost":{"type":"number","minimum":0,"maximum":1000000000000},"hours":{"type":"number","exclusiveMinimum":0,"maximum":1000000},"overhead":{"type":"number","minimum":0,"maximum":100},"margin":{"type":"number","minimum":0,"maximum":95},"riskBuffer":{"type":"number","minimum":0,"maximum":100}},"required":["hourlyCost","hours","overhead","margin","riskBuffer"],"additionalProperties":false},"effect":{"effect":"read","hash":"b50d9bbdc91d5ce37b502c62983599bfb91d34fc173bfa5854a51379c2c51d83"}},{"name":"business_days","description":"Count weekdays between dates or add/subtract days. UTC dates, Monday–Friday; start included and end excluded unless includeEnd. Offset excludes start. Public holidays are not excluded. Free, no authentication required. Rate limited.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","oneOf":[{"type":"object","properties":{"mode":{"type":"string","const":"between"},"startDate":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},"endDate":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},"includeEnd":{"default":false,"type":"boolean"}},"required":["mode","startDate","endDate"],"additionalProperties":false},{"type":"object","properties":{"mode":{"type":"string","const":"offset"},"startDate":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},"days":{"type":"integer","minimum":0,"maximum":36525},"direction":{"default":"add","type":"string","enum":["add","subtract"]},"businessOnly":{"default":true,"type":"boolean"}},"required":["mode","startDate","days"],"additionalProperties":false}]},"effect":{"effect":"read","hash":"1c7dfb158563a6c4bd6cef2991323853157aa4b462e40a979d7fc94e52338f64"}},{"name":"risk_assessment","description":"Score user-supplied risks using likelihood × impact (1–5). Low <=6, medium <=14, high >=15. Does not infer likelihood or impact. Free, no authentication required. Rate limited.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"risks":{"minItems":1,"maxItems":100,"type":"array","items":{"type":"object","properties":{"name":{"type":"string","minLength":1,"maxLength":2000},"likelihood":{"type":"integer","minimum":1,"maximum":5},"impact":{"type":"integer","minimum":1,"maximum":5},"mitigation":{"default":"","type":"string","maxLength":2000}},"required":["name","likelihood","impact"],"additionalProperties":false}}},"required":["risks"],"additionalProperties":false},"effect":{"effect":"read","hash":"8178c615944e8ddde15079e648058261d036292e378eeb15eddbd93fe8090c00"}},{"name":"coaching_agreement","description":"Generate the website's coaching agreement as plain text. Missing text fields use placeholders. Draft only; legal review may be needed. Free, no authentication required. Rate limited.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"coachName":{"default":"","type":"string","maxLength":2000},"businessName":{"default":"","type":"string","maxLength":2000},"clientName":{"default":"","type":"string","maxLength":2000},"coachingType":{"default":"life coaching","type":"string","maxLength":2000},"sessionFormat":{"default":"1:1 video calls","type":"string","enum":["1:1 video calls","1:1 phone calls","In-person sessions","Group sessions"]},"programLength":{"default":"","type":"string","maxLength":2000},"sessionLength":{"default":60,"type":"integer","exclusiveMinimum":0,"maximum":1440},"fee":{"default":"","type":"string","maxLength":2000},"paymentTerms":{"default":"Full payment upfront","type":"string","enum":["Full payment upfront","50% upfront, 50% at midpoint","Monthly installments","Pay per session"]},"cancellationPolicy":{"default":"24 hours notice required","type":"string","enum":["24 hours notice required","48 hours notice required","No refunds after session 1"]},"startDate":{"default":"","type":"string","maxLength":2000}},"additionalProperties":false},"effect":{"effect":"read","hash":"ae2879445c4ddb636e5bd92aaf0c3632dbac42bae94afc0d199640a96f4410b9"}},{"name":"retainer_agreement","description":"Generate the website's monthly retainer agreement as plain text. Missing text fields use placeholders. Draft only; legal review may be needed. Free, no authentication required. Rate limited.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"providerName":{"default":"","type":"string","maxLength":2000},"clientName":{"default":"","type":"string","maxLength":2000},"serviceType":{"default":"ongoing marketing and design services","type":"string","maxLength":2000},"monthlyFee":{"default":"","type":"string","maxLength":2000},"includedScope":{"default":"","type":"string","maxLength":2000},"overageRate":{"default":"","type":"string","maxLength":2000},"contractTerm":{"default":"Month-to-month","type":"string","enum":["Month-to-month","3-month minimum","6-month minimum","12-month term"]},"noticePeriod":{"default":"30 days written notice","type":"string","enum":["30 days written notice","60 days written notice","14 days written notice"]},"paymentDue":{"default":"1st of each month, in advance","type":"string","enum":["1st of each month, in advance","Net 15","Net 30"]},"startDate":{"default":"","type":"string","maxLength":2000}},"additionalProperties":false},"effect":{"effect":"read","hash":"6e02b715e31d991203692b298e225ba144f42da70c737b1850f402d1d56b25e2"}},{"name":"uae_vat","description":"Estimate standard 5% UAE VAT in AED, inclusive or exclusive. Does not classify exempt or zero-rated supplies. Free, no authentication required. Rate limited.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"amount":{"type":"number","minimum":0,"maximum":1000000000000},"includeVat":{"default":false,"type":"boolean"}},"required":["amount"],"additionalProperties":false},"effect":{"effect":"read","hash":"de7765e26af21412489eb80be811f5931a1c6f8fba56dde732daf355e8aedae5"}},{"name":"uae_corporate_tax","description":"Estimate standard UAE corporate tax on already-adjusted taxable income in AED: 0% up to 375000 and 9% above. Does not determine deductions, free-zone rules, relief or multinational minimum tax. Free, no authentication required. Rate limited.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"taxableIncome":{"type":"number","minimum":0,"maximum":1000000000000}},"required":["taxableIncome"],"additionalProperties":false},"effect":{"effect":"read","hash":"2db8feb0b9bfcd3365967d260922fa5cc0833cad63b9362e8ceb9d406ab28105"}},{"name":"uae_gratuity","description":"AED estimate for covered private-sector full-time foreign workers using monthly basic salary, at least one year service, 21 days for first five years then 30; capped at 24 months basic salary. Assumes continuous service without unpaid leave; no deductions or alternative schemes assessed. Free, no authentication required. Rate limited.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"basicSalary":{"type":"number","exclusiveMinimum":0,"maximum":1000000000000},"startDate":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},"endDate":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"}},"required":["basicSalary","startDate","endDate"],"additionalProperties":false},"effect":{"effect":"read","hash":"973299d47e7fc621be4ac63f5a40db03f670a8958e552b65ad824fe9af1e4a32"}},{"name":"uae_real_estate_vat","description":"Estimate VAT on ordinary commercial/residential property in AED, not transfer fees. Residential zero-rating requires FIRST supply within three years of completion; other residential supply exempt. No mixed-use or specialist properties. Free, no authentication required. Rate limited.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"amount":{"type":"number","minimum":0,"maximum":1000000000000},"includeVat":{"default":false,"type":"boolean"},"propertyType":{"type":"string","enum":["commercial","residential"]},"firstSupply":{"type":"boolean"},"yearsSinceCompletion":{"type":"number","minimum":0,"maximum":1000}},"required":["amount","propertyType","firstSupply","yearsSinceCompletion"],"additionalProperties":false},"effect":{"effect":"read","hash":"1e19dfd351f1fe86a468e59a32ca347646bdfc37aaf0e8adc28b2e2d02549c25"}},{"name":"quotation_generate","description":"Generate quotation JSON and plain-text draft with percentage discounts per item and tax on discounted amounts. Does not save, send, or render PDF; website provides visual export. Currency is a label, no FX conversion. Free, no authentication required. Rate limited.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"quotationNumber":{"type":"string","minLength":1,"maxLength":2000},"sender":{"type":"string","minLength":1,"maxLength":2000},"client":{"type":"string","minLength":1,"maxLength":2000},"currency":{"type":"string","pattern":"^[A-Z]{3}$"},"lineItems":{"minItems":1,"maxItems":100,"type":"array","items":{"type":"object","properties":{"itemName":{"type":"string","minLength":1,"maxLength":2000},"quantity":{"type":"number","exclusiveMinimum":0,"maximum":1000000},"rate":{"type":"number","minimum":0,"maximum":1000000000000},"discount":{"default":0,"type":"number","minimum":0,"maximum":100},"tax":{"default":0,"type":"number","minimum":0,"maximum":100}},"required":["itemName","quantity","rate"],"additionalProperties":false}}},"required":["quotationNumber","sender","client","currency","lineItems"],"additionalProperties":false},"effect":{"effect":"read","hash":"b899ef27af513d4a735f359b947ddfe7b0ae270e12466d76b0a0badb804d0bed"}},{"name":"sow_generate","description":"Generate a scope-of-work draft using the existing Heffl DeepSeek service. Returns untrusted HTML, not legal advice. Drafts may infer details; verify before use. Provider configuration required server-side. Free, no authentication required. Rate limited.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"clientName":{"default":"","type":"string","maxLength":200},"projectTitle":{"type":"string","minLength":1,"maxLength":200},"serviceCategory":{"default":"","type":"string","maxLength":120},"projectGoals":{"type":"string","minLength":10,"maxLength":4000},"deliverables":{"default":[],"maxItems":30,"type":"array","items":{"type":"string","maxLength":300}},"timeline":{"default":"","type":"string","maxLength":200}},"required":["projectTitle","projectGoals"],"additionalProperties":false},"effect":{"effect":"read","hash":"4ba515fe0d91fa4071544aa6a4181f130b314889515b08c3c2761c009c56c272"}},{"name":"whatsapp_generate","description":"Generate a business WhatsApp message draft using Heffl's DeepSeek service. Only drafts text; never sends messages. Provider configuration required server-side. Free, no authentication required. Rate limited.","inputSchema":{"type":"object","$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"useCase":{"type":"string","minLength":1,"maxLength":2000},"businessName":{"default":"","type":"string","maxLength":2000},"businessBio":{"default":"","type":"string","maxLength":2000},"messageTone":{"default":"Professional","type":"string","maxLength":100},"addEmoji":{"default":false,"type":"boolean"}},"required":["useCase"],"additionalProperties":false},"effect":{"effect":"read","hash":"ff8026a24b9cca29761c4d238a7feb8104553021d4126f8fc33b79f512024766"}}]}
