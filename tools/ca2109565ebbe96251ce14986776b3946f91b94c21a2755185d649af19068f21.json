{"tools":[{"name":"studio_create_project","description":"Creates an anonymous project and returns the Studio link for the person plus an agent token for later edits. In one call it can start from a template (studio_list_templates), a guide example (studio_list_examples) or your own actions (studio_get_guide); aspect \"9:16\" makes a vertical Short.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"name":{"type":"string","minLength":1,"maxLength":200},"locale":{"default":"en","type":"string"},"agentLabel":{"default":"AI agent","type":"string","minLength":1,"maxLength":100},"aspect":{"type":"string","enum":["16:9","9:16"]},"template":{"type":"object","properties":{"id":{"type":"string","minLength":1},"values":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["id"]},"example":{"type":"string","minLength":1},"actions":{"maxItems":200,"type":"array","items":{"type":"object","properties":{"actionId":{"type":"string","minLength":1},"input":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["actionId","input"]}}}},"effect":{"effect":"write","hash":"cca77054ca6268b048a27475b99d86308c39c696a76af8846041e2c84b9b04bf"}},{"name":"studio_join_project","description":"Consumes a five-minute one-time pairing code shown by Studio.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"pairingCode":{"type":"string","minLength":20,"maxLength":64}},"required":["pairingCode"]},"effect":{"effect":"write","hash":"935e55d1b2641035eede6deda018e3c27a8cc0fce2b2e851c1f53c76bab0f138"}},{"name":"studio_list_capabilities","description":"Lists the live action registry. Call this before preparing or modifying a project.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"category":{"type":"string","minLength":1,"maxLength":40}}},"effect":{"effect":"read","hash":"25d73fc3bfe7df661a855bf06da6ebee168370dc7e86d9d47d0e40ec0de6898e"}},{"name":"studio_describe_capabilities","description":"Returns schemas and examples for one or more Studio actions.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"actionIds":{"minItems":1,"maxItems":30,"type":"array","items":{"type":"string"}}},"required":["actionIds"]},"effect":{"effect":"read","hash":"db7998de6d0f1411daf535daf847657c60a51b961ed466c6ae9241c30373d1c6"}},{"name":"studio_get_project_summary","description":"Reads the current revision and a compact timeline summary. Set includeProject only when complete raw data is needed.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"projectId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"},"agentToken":{"type":"string","minLength":20},"includeProject":{"default":false,"type":"boolean"}},"required":["projectId","agentToken"]},"effect":{"effect":"read","hash":"56f77613c24ef029c36f6c0c0af3f7a0132425b918248069ccf5b6e2d8ce545c"}},{"name":"studio_apply_actions","description":"Atomically applies one or more registered actions. Non-conflicting stale edits are rebased; conflicting edits are rejected.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"projectId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"},"agentToken":{"type":"string","minLength":20},"baseRevision":{"type":"integer","minimum":0,"maximum":9007199254740991},"clientMutationId":{"type":"string","minLength":8,"maxLength":200},"locale":{"default":"en","type":"string"},"actions":{"minItems":1,"maxItems":100,"type":"array","items":{"type":"object","properties":{"actionId":{"type":"string","minLength":1},"input":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["actionId","input"]}}},"required":["projectId","agentToken","baseRevision","actions"]},"effect":{"effect":"write","hash":"43145f1a6669e5361b5cf2a497ba5897fdbac37c8331077d34d4c152ea4d8c1b"}},{"name":"studio_validate_project","description":"Checks entity, track, clip, timing, and reference integrity.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"projectId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"},"agentToken":{"type":"string","minLength":20}},"required":["projectId","agentToken"]},"effect":{"effect":"read","hash":"cc1252a53aeb2ebc6f7f44dc3502422964d777fcd260213c1ee39b19db4f9768"}},{"name":"studio_get_guide","description":"Everything needed to build a story in one read: the fastest paths, how pieces combine (frame, shapes, move, mark, say, link, data, look), a complete example and the actions with their schemas. Read it once before building from scratch.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{}},"effect":{"effect":"read","hash":"e7eb69d7378a7e07bcc54de81ec4b11feaecf8a611cdf269c5f751a54bcf6e42"}},{"name":"studio_list_templates","description":"Ready-made stories to fill in (a trip with stops, visited countries, an invasion, a growing empire, World War I and II, data maps, breaking news…). Pass one to studio_create_project as template { id, values }; values not given keep the defaults shown.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{}},"effect":{"effect":"read","hash":"5426bf46618e5e0a2bb70b9e9e2e0adad1904cf0f3339d3633c6af21abed7af9"}},{"name":"studio_list_examples","description":"Finished stories from the guides (a wildfire spreading, the euro year by year, a bar chart race, a war map, a train trip…). Start from one with studio_create_project example, then adapt places, texts and numbers with studio_apply_actions.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{}},"effect":{"effect":"read","hash":"d57d202a721e908de02ce9bf56bbf4c0012c3085546fdc95e42baa3348d1ab35"}},{"name":"studio_find_places","description":"Real coordinates for cities, towns and landmarks ([lat, lng], from OpenStreetMap) and the countries Studio can draw (with isoA2). Use it instead of guessing coordinates.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"query":{"type":"string","minLength":2,"maxLength":120},"limit":{"default":5,"type":"integer","minimum":1,"maximum":10}},"required":["query"]},"effect":{"effect":"read","hash":"afe498cb94978eaf5d7d5b11f36a441d4b34c41ba7a32feb8691dfaf55a61a79"}},{"name":"studio_request_preview","description":"Asks an open Studio browser to render a frame locally.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"projectId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"},"agentToken":{"type":"string","minLength":20},"locale":{"default":"en","type":"string"},"timeMs":{"type":"integer","minimum":0,"maximum":9007199254740991},"format":{"type":"string","enum":["mp4","webm"]},"quality":{"type":"string","enum":["720p","1080p","2k","4k"]},"aspect":{"type":"string","enum":["16:9","9:16"]},"fps":{"anyOf":[{"type":"number","const":24},{"type":"number","const":25},{"type":"number","const":30},{"type":"number","const":60}]}},"required":["projectId","agentToken"]},"effect":{"effect":"write","hash":"a8881af63b5fe1ea6b087c38f98078581fc48f86b132dcda86c912a253b1f143"}},{"name":"studio_request_export","description":"Asks an open Studio browser to render and download the video locally.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"projectId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"},"agentToken":{"type":"string","minLength":20},"locale":{"default":"en","type":"string"},"timeMs":{"type":"integer","minimum":0,"maximum":9007199254740991},"format":{"type":"string","enum":["mp4","webm"]},"quality":{"type":"string","enum":["720p","1080p","2k","4k"]},"aspect":{"type":"string","enum":["16:9","9:16"]},"fps":{"anyOf":[{"type":"number","const":24},{"type":"number","const":25},{"type":"number","const":30},{"type":"number","const":60}]}},"required":["projectId","agentToken"]},"effect":{"effect":"write","hash":"e70f97a467c3657e2a51934194ed73bf18e9f14277a51fac6d12f2720bdab0d3"}},{"name":"studio_get_job","description":"Checks a local browser preview/export request.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"projectId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"},"agentToken":{"type":"string","minLength":20},"jobId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"}},"required":["projectId","agentToken","jobId"]},"effect":{"effect":"read","hash":"086d00417b1e6d8b609ee16382c598dd01c82e44174753a60c14b31a306fc5d2"}},{"name":"studio_export_json","description":"Returns the portable .amtstudio.json content without collaboration secrets.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"projectId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$"},"agentToken":{"type":"string","minLength":20}},"required":["projectId","agentToken"]},"effect":{"effect":"read","hash":"ca461ca9c6c0fb48f5b4397c75561af789182eb7d05f82b8539700bfefa2b2fb"}}]}
